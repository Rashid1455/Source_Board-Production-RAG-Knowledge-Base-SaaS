# Local development only. Replace credentials before any shared deployment.
POSTGRES_PASSWORD=sourceboard
DATABASE_URL=postgresql://sourceboard:sourceboard@localhost:5432/sourceboard
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sourceboard
S3_SECRET_KEY=sourceboard-local-only
S3_BUCKET=sourceboard
S3_REGION=us-east-1
# Set your server-side provider key. Never put this in NEXT_PUBLIC_* variables.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
# Gemini alternative (use a Google AI Studio key above):
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_MODEL=gemini-embedding-2
# CHAT_MODEL=gemini-3.5-flash-lite
MIN_SIMILARITY=0.40
